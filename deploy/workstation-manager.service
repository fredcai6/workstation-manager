[Unit]
Description=GPU manager broker: batch queue and the :8005/:8006 front door

[Service]
# `gpu` on this path is a symlink to the repo's ./gpu.
ExecStart=%h/.local/bin/gpu daemon
Restart=always
# The bridge addresses it listens on appear when Docker starts; retry until they do.
RestartSec=5

[Install]
WantedBy=default.target
