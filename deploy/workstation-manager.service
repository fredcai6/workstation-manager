[Unit]
Description=Workstation manager broker: queue and leases for cores, memory and the GPU; the :8005/:8006 front door

[Service]
# `ws` on this path is a symlink to the repo's ./ws.
ExecStart=%h/.local/bin/ws daemon
Restart=always
# The bridge addresses it listens on appear when Docker starts; retry until they do.
RestartSec=5

[Install]
WantedBy=default.target
